<?xml version="1.0" encoding="utf-8"?>
<!--
  Il lint non segnala le versioni piu' nuove delle dipendenze fissate di proposito in una versione di correzione:
  aggiornarle cambierebbe l'albero che le app ereditano. Ogni voce vale solo per la versione fissata qui sotto
  (se la dipendenza cambia versione, l'avviso torna). Nessun controllo e' disattivato.
-->
<lint>
  <issue id="NewerVersionAvailable">
    <!-- le coroutines restano alla 1.8.1 di tutto l'albero dell'engine (versions.gradle) -->
    <ignore regexp="org\.jetbrains\.kotlinx:kotlinx-coroutines-android than 1\.8\.1 is available" />
  </issue>
</lint>
