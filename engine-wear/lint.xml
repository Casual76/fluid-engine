  (se la dipendenza cambia versione, l'avviso torna). Nessun controllo e' disattivato.
-->
<lint>
  <issue id="GradleDependency">
    <!-- Wear Compose resta alla 1.6.2 (toolchain dell'engine) -->
    <ignore regexp="androidx\.wear\.compose:compose-material3 than 1\.6\.2 is available" />
    <!-- Wear Compose resta alla 1.6.2 (toolchain dell'engine) -->
    <ignore regexp="androidx\.wear\.compose:compose-foundation than 1\.6\.2 is available" />
  </issue>
</lint>
