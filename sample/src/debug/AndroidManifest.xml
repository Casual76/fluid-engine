<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!--
    F8.11 · La scena «Permesso nel punto giusto» chiede le foto (anche «solo alcune» da Android 14), le notifiche e la
    posizione approssimativa, come MyCloud Gallery, Pampa Mail e Fluid Transit. Solo nella build di debug: Fluid Glass
    pubblicata non chiede niente di tutto questo. Niente CAMERA (checkArViewerManifests); RECORD_AUDIO solo per il registratore di F8.13 (sotto).
  -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!--
    F8.19 · Il promemoria «fra un minuto» arriva al minuto con l'allarme esatto («Sveglie e promemoria»): da Android 13 non
    è concesso di serie, la scena porta nel punto giusto delle impostazioni. Solo nella build di debug, come le notifiche.
  -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <!--
    F8.13 · Il registratore della scena «I memo vocali» registra col microfono vero (engine-audio). Solo nella build di
    debug: il manifest principale toglie RECORD_AUDIO perche' Fluid Glass pubblicata non ascolta mai; qui torna, e lo si
    chiede solo al tasto rosso.
  -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="replace" />
  <application>
    <!--
      F8.22 · «Cerca in Pampa»: le cinque app finte della scena, un ospite del ponte firmato ciascuna (AiToolHostProvider
      col tool della ricerca). Solo nella build di debug e non esportati: rispondono solo alla galleria stessa, e senza
      il meta-data TOOL_HOST nessun assistente del telefono (PampAI) li trova.
    -->
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F8p22NotesHost"
        android:authorities="${applicationId}.f8p22.notes" android:exported="false" />
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F8p22MailHost"
        android:authorities="${applicationId}.f8p22.mail" android:exported="false" />
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F8p22SchoolHost"
        android:authorities="${applicationId}.f8p22.classeviva" android:exported="false" />
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F8p22GalleryHost"
        android:authorities="${applicationId}.f8p22.gallery" android:exported="false" />
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F8p22AssistantHost"
        android:authorities="${applicationId}.f8p22.pampai" android:exported="false" />
    <!--
      F9.1 · Il PampAI finto della scena «PampAI per le app»: l'ospite dell'assistenza (AiAssistHostProvider) e la sua
      pagina del consenso e delle impostazioni, in un processo a parte (`:pampai`), cosi' la domanda della galleria passa
      da un vero Binder fra due processi come fra un'app e PampAI. Non esportati: rispondono solo alla galleria stessa, e
      nessuna app del telefono li trova. Il modello e' finto: nessuna rete, nessuna chiave.
    -->
    <provider android:name="dev.antigravity.fluidengine.sample.novita.F9p1FakePampaiHost"
        android:authorities="${applicationId}.ai.assist" android:exported="false" android:process=":pampai">
      <meta-data android:name="dev.antigravity.fluidengine.ai.ASSIST_HOST" android:value="3" />
    </provider>
    <activity android:name="dev.antigravity.fluidengine.sample.novita.F9p1FakePampaiActivity"
        android:exported="false" android:process=":pampai" android:theme="@style/Theme.FluidSample"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboardHidden">
      <intent-filter>
        <action android:name="dev.antigravity.fluidengine.ai.action.ASSIST_CONSENT" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>

</manifest>
