<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.FluidSample">
    <!--
      configChanges: la galleria e' una pagina di prova con uno stato che non si vuole perdere (il
      registro aptico, la grana tarata, dove si era arrivati): passare al tema scuro di sistema, ruotare
      o cambiare la dimensione del testo non deve ricreare l'attivita' e azzerare tutto. Compose segue
      da solo questi cambiamenti.
    -->
    <activity
        android:name=".GalleryActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboardHidden"
        android:theme="@style/Theme.FluidSample">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- Le pagine della 3.0: il back predittivo deve arrivare all'host, quindi acceso qui. -->
    <activity
        android:name=".PagesDemoActivity"
        android:exported="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.FluidSample" />
  </application>

</manifest>
