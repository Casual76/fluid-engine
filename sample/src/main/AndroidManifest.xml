<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!--
    La pagina «Assistente» (F3.2b) porta engine-ai-ui, e con lui engine-ai, che dichiara RECORD_AUDIO per la voce
    dell'assistente. La galleria non ascolta mai: il permesso non deve arrivare nell'APK.
  -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />

  <!--
    F8.20 · GalleryApplication fa partire WorkManager su richiesta (il suo avvio automatico resta tolto, sotto): il primo
    fotogramma non cambia, e un trasferimento della scena riprende anche dopo che il processo e' morto. La configurazione
    di rete permette il testo in chiaro solo verso il loopback (il server di prova della galleria e `adb reverse`).
  -->
  <application
      android:name=".GalleryApplication"
      android:networkSecurityConfig="@xml/network_security_config"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:fullBackupContent="@xml/backup_rules"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.FluidSample">
    <provider android:name=".viewer.VisoriPackageProvider"
        android:authorities="${applicationId}.visori" android:exported="false" android:grantUriPermissions="true" />
    <!--
      F8.21 · engine-sync porta WorkManager, che di serie si avvia con l'app (androidx.startup). La galleria mostra la
      sincronizzazione con dispositivi finti in memoria e non manda mai lavori in sottofondo: niente avvio, cosi' il primo
      fotogramma resta quello di prima.
    -->
    <provider
        android:name="androidx.startup.InitializationProvider"
        android:authorities="${applicationId}.androidx-startup"
        android:exported="false"
        tools:node="merge">
      <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
    </provider>
    <!--
      configChanges: la galleria e' una pagina di prova con uno stato che non si vuole perdere (il
      registro aptico, la grana tarata, dove si era arrivati): passare al tema scuro di sistema, ruotare
      o cambiare la dimensione del testo non deve ricreare l'attivita' e azzerare tutto. Compose segue
      da solo questi cambiamenti.
    -->
    <activity
        android:name=".GalleryActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboardHidden"
        android:theme="@style/Theme.FluidSample.Gallery">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- F8.10 · Le destinazioni degli arrivi diventano scorciatoie di condivisione (share-target). -->
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/fluid_glass_shortcuts" />
    </activity>
    <!--
      F8.10 · Gli arrivi da altre app (engine-share-in): un'attivita' trasparente sopra l'app di partenza, col foglio
      dell'engine. Riceve testo, link, foto e PDF (SEND, SEND_MULTIPLE) e il testo selezionato (PROCESS_TEXT, «Aggiungi a
      Fluid Glass» nel menu del testo). «Apri con» (VIEW) la galleria lo prova solo dalla scena, senza filtro: non si
      propone come visore delle foto di nessuno.
    -->
    <activity
        android:name=".novita.ShareInDemoActivity"
        android:exported="true"
        android:label="@string/app_name"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboardHidden"
        android:theme="@style/Theme.FluidShareIn">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/pdf" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter android:label="Aggiungi a Fluid Glass">
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <!-- Gli indirizzi della galleria arrivano alla stessa pila anche quando la scena è già aperta. -->
    <activity
        android:name=".novita.AddressDemoActivity"
        android:exported="true"
        android:launchMode="singleTop"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/Theme.FluidSample">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="fluidglass" />
      </intent-filter>
    </activity>
    <!--
      F8.25 · La vetrina dei widget (engine-widget): due widget di prova (Glance) da aggiungere alla Home con
      requestPinAppWidget, e un riquadro delle Impostazioni rapide da proporre (requestAddTileService, Android 13). Non
      esportati se non dove Android lo chiede (il launcher e la barra di stato li legano col loro permesso).
    -->
    <receiver
        android:name=".novita.F8p25AgendaWidgetReceiver"
        android:label="@string/f8p25_agenda_label"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/f8p25_widget_agenda" />
    </receiver>
    <receiver
        android:name=".novita.F8p25AbsencesWidgetReceiver"
        android:label="@string/f8p25_absences_label"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/f8p25_widget_absences" />
    </receiver>
    <service
        android:name=".novita.F8p25QuickTileService"
        android:label="@string/f8p25_quick_tile_label"
        android:icon="@drawable/f8p25_quick_tile"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
        android:exported="true">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <!-- Le pagine della 3.0: il back predittivo deve arrivare all'host, quindi acceso qui. -->
    <activity
        android:name=".PagesDemoActivity"
        android:exported="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:theme="@style/Theme.FluidSample" />
  </application>

</manifest>
