<?xml version="1.0" encoding="utf-8"?>
<!--
  F8.25c · L'anteprima dell'agenda di prova per il launcher (android:previewLayout, da Android 12): la taglia piccola come
  la disegna il widget vero (righe impilate, nomi interi). Solo viste ammesse in RemoteViews: niente View, il separatore
  e' un FrameLayout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/f8p25_widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

  <TextView
      android:id="@+id/f8p25_preview_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/f8p25_preview_today"
      android:textColor="@color/f8p25_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:background="@drawable/f8p25_widget_preview_card"
      android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/f8p25_preview_lesson1"
          android:textColor="@color/f8p25_widget_text"
          android:textSize="13sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/f8p25_preview_time1"
          android:textColor="@color/f8p25_widget_accent"
          android:textSize="11sp"
          android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:background="@color/f8p25_widget_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:text="@string/f8p25_preview_lesson2"
          android:textColor="@color/f8p25_widget_text"
          android:textSize="13sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/f8p25_preview_time2"
          android:textColor="@color/f8p25_widget_secondary"
          android:textSize="11sp"
          android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
