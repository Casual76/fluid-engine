<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Compose paints everything; the platform theme only has to stay out of the way and let the
       window go edge to edge, so the bars have something to actually sit over. -->
  <style name="Theme.FluidSample" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <!--
    F8.11 · La galleria parte dal tema dell'engine per il primo fotogramma pronto: la finestra ha gia' il colore della pagina
    (chiaro o scuro, dal sistema) e le icone delle barre stanno dalla parte giusta. Solo GalleryActivity: le altre Activity e
    quella vuota delle prove restano su Theme.FluidSample. Per lasciare la schermata d'avvio di Android com'era di sistema
    basta il parent Theme.Fluid.SystemSplash: il primo fotogramma resta del colore della pagina (fluidFirstFrame).
  -->
  <style name="Theme.FluidSample.Gallery" parent="Theme.Fluid" />
</resources>
