<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Compose paints everything; the platform theme only has to stay out of the way and let the
       window go edge to edge, so the bars have something to actually sit over. -->
  <style name="Theme.FluidSample" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>
</resources>
