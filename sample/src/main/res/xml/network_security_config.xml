<?xml version="1.0" encoding="utf-8"?>
<!--
  F8.20 · Il testo in chiaro solo verso il telefono stesso: il server di prova della scena «Centro trasferimenti» (sul
  loopback) e quello del PC raggiunto con `adb reverse tcp:8765 tcp:8765`. Tutto il resto resta solo HTTPS.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
