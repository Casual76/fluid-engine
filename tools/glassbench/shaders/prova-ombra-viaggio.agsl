// SONDA dell'ombra in viaggio (F1A.4): NON e' il materiale.
//
// `GlassTravelShadowBlock` (engine-ui/.../ui/glass/field/GlassShadow.kt) e' un blocco senza `main`:
// l'engine lo include nel corpo, dietro `lightInBody`. Questa sonda lo mette sotto una campitura
// piatta, con il nucleo a 8 pezzi, per guardare e misurare l'ombra da sola (scene
// `scenes/f1a/prova-ombra-viaggio-*.json`) e per confrontarla con le maschere a riposo.
//
// LA SORGENTE E' IL KOTLIN. Il testo fra i segni `>>>` e `<<<` e' una copia delle due costanti, con
// i template `$Nome` gia' risolti: non si corregge qui. Se una costante cambia, la copia si riscrive
// (artifacts/liquid-glass/bench/f1a-4/genera_sonda.py, o a mano), e `GlassShadowTest` fallisce
// finche' non tornano uguali.
//
// `showMode`: 0 = campitura `fillColor` sopra l'ombra, composta come la compone il corpo
// (`colour * coverage + shade * (1 - coverage)`); 1 = la sola ombra, non scavata (cio' che
// `glassTravelShadow` restituisce); 2 = la sola ombra, scavata.

uniform float showMode;
uniform float aa;                        // antialias della maschera (px)
layout(color) uniform half4 fillColor;

// >>> GlassFieldKernel8
uniform float2 offset;
uniform float4 flex;
uniform float2 flexCenter;

float2 glassFieldPoint(float2 coord) {
    float2 rel = coord + offset - flexCenter;
    return flexCenter + float2(dot(flex.xy, rel), dot(flex.zw, rel));
}

uniform float pieceCount;
uniform float4 pieceRect[8];
uniform float4 pieceRadii[8];
uniform float pieceBlend[8];
uniform float pieceSmooth[8];
uniform float pieceSoft[8];

float glassRadiusAt(float2 rel, float4 radii) {
    if (rel.x >= 0.0) {
        if (rel.y <= 0.0) return radii.y;
        else return radii.z;
    } else {
        if (rel.y <= 0.0) return radii.x;
        else return radii.w;
    }
}

float3 glassWideBox(float2 rel, float2 halfSize) {
    float2 b = abs(rel) - halfSize;
    float2 side = float2(rel.x < 0.0 ? -1.0 : 1.0, rel.y < 0.0 ? -1.0 : 1.0);
    if (b.x > 0.0 && b.y > 0.0) return float3(length(b), side * (b / length(b)));
    float gx = step(b.y, b.x);
    return float3(max(b.x, b.y), side * float2(gx, 1.0 - gx));
}

float3 glassWideCorner(float3 held, float2 rel, float2 halfSize, float2 side, float radius) {
    // `q`: il punto visto dal centro dell'arco, con gli assi che puntano al vertice dell'angolo.
    float2 q = rel * side - (halfSize - float2(radius));
    if (q.x <= 0.0 || q.y <= 0.0) return held;
    float len = length(q);
    if (len - radius <= held.x) return held;
    return float3(len - radius, side * (q / len));
}

float glassWideSpread(float radius, float minHalf, float roomX, float roomY) {
    return max(radius, min(min(radius * 1.5, minHalf), min(roomX, roomY)));
}

float3 glassWideSlab(float2 rel, float2 halfSize, float4 radii) {
    float4 r = max(radii, float4(0.0));
    float3 box = glassWideBox(rel, halfSize);
    float3 held = glassWideCorner(box, rel, halfSize, float2(-1.0, -1.0), r.x);
    held = glassWideCorner(held, rel, halfSize, float2(1.0, -1.0), r.y);
    held = glassWideCorner(held, rel, halfSize, float2(1.0, 1.0), r.z);
    held = glassWideCorner(held, rel, halfSize, float2(-1.0, 1.0), r.w);
    float sd = held.x;

    // La normale: gli stessi quattro archi allargati, ognuno dentro il lato che il vicino gli lascia.
    float minHalf = min(halfSize.x, halfSize.y);
    float2 whole = halfSize * 2.0;
    held = glassWideCorner(box, rel, halfSize, float2(-1.0, -1.0),
        glassWideSpread(r.x, minHalf, whole.x - r.y, whole.y - r.w));
    held = glassWideCorner(held, rel, halfSize, float2(1.0, -1.0),
        glassWideSpread(r.y, minHalf, whole.x - r.x, whole.y - r.z));
    held = glassWideCorner(held, rel, halfSize, float2(1.0, 1.0),
        glassWideSpread(r.z, minHalf, whole.x - r.w, whole.y - r.y));
    held = glassWideCorner(held, rel, halfSize, float2(-1.0, 1.0),
        glassWideSpread(r.w, minHalf, whole.x - r.z, whole.y - r.x));
    return float3(sd, held.yz);
}

float3 glassSlab(float2 rel, float2 halfSize, float4 radii, float smoothing) {
    float minHalf = min(halfSize.x, halfSize.y);
    // Un angolo oltre mezzo lato corto: il quadrante non basta a dire di quale angolo e' un punto. Solo se i
    // raggi stanno nei lati (due vicini non superano il lato che dividono): un raggio chiesto troppo grande,
    // il 999 di una capsula, resta limitato a mezzo lato come sempre.
    if (max(max(radii.x, radii.y), max(radii.z, radii.w)) > minHalf * 1.0001) {
        float2 room = halfSize * (2.0 * 1.0001);
        if (max(radii.x + radii.y, radii.w + radii.z) <= room.x
            && max(radii.x + radii.w, radii.y + radii.z) <= room.y) {
            return glassWideSlab(rel, halfSize, radii);
        }
    }
    float radius = max(min(glassRadiusAt(rel, radii), minHalf), 0.0);
    // Lo smoothing che il lato corto lascia spendere: zero quando l'angolo e' gia' un semicerchio.
    float s = radius > 0.0001 ? clamp(min(smoothing, minHalf / radius - 1.0), 0.0, 1.0) : 0.0;
    float s2 = s * s;
    float reach = radius * (1.0 + s2 * (0.25 + 0.495 * s));
    float power = 2.0 + s2 * (0.79 + 1.0 * s);
    float2 a = abs(rel);
    float2 side = float2(rel.x < 0.0 ? -1.0 : 1.0, rel.y < 0.0 ? -1.0 : 1.0);

    float2 q = a - (halfSize - float2(reach));
    float sd;
    if (q.x <= 0.0 || q.y <= 0.0) {
        sd = max(q.x, q.y) - reach;
    } else if (s <= 0.0) {
        sd = length(q) - reach;
    } else {
        float2 qp = pow(q, float2(power - 1.0));
        float sum = max(dot(qp, q), 1.0e-20);
        float norm = pow(sum, 1.0 / power);
        float slope = length(qp) * norm / sum;
        float m = norm - reach;
        sd = m / mix(slope, 1.0, clamp(-m / reach, 0.0, 1.0));
    }

    // La normale: lo stesso pezzo con l'angolo allargato, mai oltre mezzo lato corto.
    float wide = min(reach * 1.5, minHalf);
    float2 w = a - (halfSize - float2(wide));
    float2 n;
    if (w.x <= 0.0 || w.y <= 0.0) {
        float gx = step(w.y, w.x);
        n = float2(gx, 1.0 - gx);
    } else if (s <= 0.0) {
        n = w / length(w);
    } else {
        float2 wp = pow(w, float2(power - 1.0));
        float wl = length(wp);
        n = wl > 1.0e-20 ? wp / wl : float2(0.70710678);
    }
    return float3(sd, side * n);
}

float glassCircleMap(float x) {
    return 1.0 - sqrt(max(1.0 - x * x, 0.0));
}

float glassField(float2 p, out float2 normal, out float2 center) {
    float d = 1000000.0;
    normal = float2(0.0);
    center = float2(0.0);
    for (int i = 0; i < 8; ++i) {
        if (float(i) >= pieceCount) break;
        float3 slab = glassSlab(p - pieceRect[i].xy, pieceRect[i].zw, pieceRadii[i], pieceSmooth[i]);
        if (i == 0) {
            d = slab.x;
            normal = slab.yz;
            center = pieceRect[i].xy;
        } else {
            // Il raggio di fusione e' del pezzo: lo unisce a tutto cio' che il ciclo ha gia' fuso.
            float k = max(pieceBlend[i], 0.0001);
            float h = clamp(0.5 + 0.5 * (slab.x - d) / k, 0.0, 1.0);
            // Normale e centro si pesano su un raggio che non e' mai sotto quello della sagoma, e dove i pezzi si
            // sovrappongono sale a `pieceSoft` (F1B.2): due pezzi sovrapposti con centri diversi non si contendono
            // piu' il punto a scatto. La sagoma non cambia: `d` resta quella di sempre.
            float ka = max(k, pieceSoft[i]);
            float ha = clamp(0.5 + 0.5 * (slab.x - d) / ka, 0.0, 1.0);
            d = slab.x + (d - slab.x) * h - k * h * (1.0 - h);
            normal = mix(slab.yz, normal, ha);
            center = mix(pieceRect[i].xy, center, ha);
        }
    }
    return d;
}
// <<< GlassFieldKernel8

// >>> GlassTravelShadowBlock
uniform float2 shadowOffset;
uniform float2 shadowRadii;
uniform float2 shadowAlphas;
layout(color) uniform half4 shadowColor;

float glassShadowSigma(float radius) {
    return 0.57735 * max(radius, 0.0) + 0.5;
}

float glassShadowFall(float x, float sigma) {
    float z = abs(x) / (sigma * 1.41421356);
    float poly = 1.0 + z * (0.278393 + z * (0.230389 + z * (0.000972 + z * 0.078108)));
    poly = poly * poly;
    float tail = 0.5 / (poly * poly);
    return x >= 0.0 ? tail : 1.0 - tail;
}

float glassShadowBox(float2 rel, float2 halfSize, float sigma) {
    return max(glassShadowFall(rel.x - halfSize.x, sigma) - glassShadowFall(rel.x + halfSize.x, sigma), 0.0)
        * max(glassShadowFall(rel.y - halfSize.y, sigma) - glassShadowFall(rel.y + halfSize.y, sigma), 0.0);
}

float glassShadowNotch(float2 rel, float2 tip, float2 inward, float radius, float spend, float sigma) {
    if (radius <= 0.0001) return 0.0;
    float s2 = spend * spend;
    float reach = radius * (1.0 + s2 * (0.25 + 0.495 * spend));
    float t = s2 * (0.79 + 1.0 * spend);
    float area = reach * reach * (0.2146 - t * (0.1414 - 0.04348 * t));
    float along = reach * (0.22337 - t * (0.06966 - 0.01552 * t));
    float2 v = rel - (tip + inward * along);
    return area * exp(-dot(v, v) / (2.0 * sigma * sigma)) / (6.2831853 * sigma * sigma);
}

float glassShadowSpend(float radius, float minHalf, float smoothing) {
    return radius > 0.0001 ? clamp(min(smoothing, minHalf / radius - 1.0), 0.0, 1.0) : 0.0;
}

float glassShadowPiece(float2 rel, float2 halfSize, float4 radii, float smoothing, float sigma) {
    float box = glassShadowBox(rel, halfSize, sigma);
    if (box <= 0.0) return 0.0;
    float minHalf = min(halfSize.x, halfSize.y);
    float4 r = clamp(radii, float4(0.0), float4(minHalf));
    float spend = smoothing;
    // Il ramo largo di `glassSlab`: un angolo oltre mezzo lato corto, se i raggi stanno nei lati, resta com'e'.
    if (max(max(radii.x, radii.y), max(radii.z, radii.w)) > minHalf * 1.0001) {
        float2 room = halfSize * (2.0 * 1.0001);
        if (max(radii.x + radii.y, radii.w + radii.z) <= room.x
            && max(radii.x + radii.w, radii.y + radii.z) <= room.y) {
            r = max(radii, float4(0.0));
            spend = 0.0;
        }
    }
    float notch = glassShadowNotch(rel, -halfSize, float2(1.0, 1.0), r.x, glassShadowSpend(r.x, minHalf, spend), sigma)
        + glassShadowNotch(rel, float2(halfSize.x, -halfSize.y), float2(-1.0, 1.0), r.y,
            glassShadowSpend(r.y, minHalf, spend), sigma)
        + glassShadowNotch(rel, halfSize, float2(-1.0, -1.0), r.z, glassShadowSpend(r.z, minHalf, spend), sigma)
        + glassShadowNotch(rel, float2(-halfSize.x, halfSize.y), float2(1.0, -1.0), r.w,
            glassShadowSpend(r.w, minHalf, spend), sigma);
    return max(box - notch, 0.0);
}
// <<< GlassTravelShadowBlock

// >>> GlassShadowMask8
float2 glassNeckPoint(float a, float b, float r, float c, float anchor) {
    float pa = a + r;
    float pb = b + r;
    float u = (pa * pa - pb * pb) / (4.0 * c);
    return float2(u, sqrt(max(pa * pa - (u + c) * (u + c), 0.0)) - anchor);
}

void glassNeckEdge(float2 p0, float2 p1, inout float2 first, inout float2 second) {
    float cr = p0.x * p1.y - p1.x * p0.y;
    first += float2(cr, (p0.y + p1.y) * cr);
    second += float2(p0.x * p0.x + p0.x * p1.x + p1.x * p1.x, p0.y * p0.y + p0.y * p1.y + p1.y * p1.y) * cr;
}

float glassShadowNeck(float2 q, float4 ri, float4 radI, float4 rj, float4 radJ, float k, float sigma) {
    // I due capi che si guardano, come li vede la CPU: l'asse dove i pezzi entrano meno, il raggio medio.
    float2 apart = abs(ri.xy - rj.xy) - (ri.zw + rj.zw);
    bool alongX = apart.x >= apart.y;
    float depth = -max(apart.x, apart.y);
    float rI = dot(clamp(radI, float4(0.0), float4(min(ri.z, ri.w))), float4(0.25));
    float rJ = dot(clamp(radJ, float4(0.0), float4(min(rj.z, rj.w))), float4(0.25));
    float r = 0.5 * (rI + rJ);
    if (r <= 0.001) return 0.0;
    float c = max(max(2.0 * r - depth, 0.0) * 0.5, 0.001 * r);
    float gap = 2.0 * (c - r);
    if (gap > 0.0 && k <= gap) return 0.0;
    float2 pu = alongX ? float2(ri.x, rj.x) : float2(ri.y, rj.y);
    float2 hu = alongX ? float2(ri.z, rj.z) : float2(ri.w, rj.w);
    float2 pv = alongX ? float2(ri.y, rj.y) : float2(ri.x, rj.x);
    float2 hv = alongX ? float2(ri.w, rj.w) : float2(ri.z, rj.z);
    float toward = pu.x < pu.y ? 1.0 : -1.0;
    float midU = 0.5 * (pu.x + toward * hu.x + pu.y - toward * hu.y);
    float midV = 0.5 * (max(pv.x - hv.x, pv.y - hv.y) + min(pv.x + hv.x, pv.y + hv.y));
    float straight = max(min(pv.x + hv.x - rI, pv.y + hv.y - rJ) - max(pv.x - hv.x + rI, pv.y - hv.y + rJ), 0.0);
    float2 local = alongX ? q : q.yx;

    // Mezzo collo dalla parte del capo A (centro in (-c, 0)): il contorno dal piede sul capo al punto di mezzo,
    // giu' fino all'asse, e l'arco del capo che torna al piede. Il raccordo ha un tetto (la CPU resta sotto 1,64 c),
    // oltre il quale il piede girerebbe dietro al capo.
    float kk = min(k, 1.6 * c);
    bool joined = gap <= 0.0 || kk >= 2.0 * gap;
    float tEnd = joined ? 0.0 : sqrt(max(kk * (2.0 * gap - kk), 0.0));
    float2 low = c >= r ? float2(r - c, 0.0) : float2(0.0, sqrt(max(r * r - c * c, 0.0)));
    float2 foot = glassNeckPoint(0.0, kk, r, c, 0.0);
    float anchor = 0.5 * (foot.y + low.y);
    foot.y -= anchor;
    low.y -= anchor;
    float2 first = float2(0.0);
    float2 second = float2(0.0);
    float2 prev = foot;
    for (int m = 1; m <= 3; ++m) {
        float t = kk + (tEnd - kk) * float(m) / 3.0;
        float a = (kk - t) * (kk - t) / (4.0 * kk);
        float2 next = glassNeckPoint(a, a + t, r, c, anchor);
        if (m == 3 && joined) next.x = 0.0;
        glassNeckEdge(prev, next, first, second);
        prev = next;
    }
    if (joined && c >= r) {
        float2 axis = float2(0.0, -anchor);
        glassNeckEdge(prev, axis, first, second);
        prev = axis;
    }
    glassNeckEdge(prev, low, first, second);
    float2 hub = float2(-c, -anchor);
    float2 e0 = normalize(low - hub);
    float2 e1 = normalize(foot - hub);
    float2 half1 = normalize(e0 + e1);
    float2 arc1 = hub + r * normalize(e0 + half1);
    float2 arc2 = hub + r * half1;
    float2 arc3 = hub + r * normalize(half1 + e1);
    glassNeckEdge(low, arc1, first, second);
    glassNeckEdge(arc1, arc2, first, second);
    glassNeckEdge(arc2, arc3, first, second);
    glassNeckEdge(arc3, foot, first, second);

    float neck = 0.0;
    float area = 0.5 * first.x;
    if (abs(area) > 0.000001 && (gap <= 0.0 || kk > gap)) {
        float centre = first.y / (6.0 * area);
        float spreadU = max(second.x / (12.0 * area), 0.0);
        float spreadV = max(second.y / (12.0 * area) - centre * centre, 0.0);
        float2 halfSize = max(sqrt(3.0 * float2(spreadU, spreadV)), float2(0.001));
        float density = abs(area) / (2.0 * halfSize.x * halfSize.y);
        float rise = 0.5 * straight + anchor + centre;
        neck = density * (glassShadowBox(local - float2(midU, midV + rise), halfSize, sigma)
            + glassShadowBox(local - float2(midU, midV - rise), halfSize, sigma));
    }
    // Il ponte fra due tratti dritti che si guardano: pieno quando il collo e' unito, due veli quando non lo e'.
    if (straight > 0.0 && gap > 0.0 && k > gap) {
        float t = sqrt(max(k * (2.0 * gap - k), 0.0));
        float filled = k >= 2.0 * gap ? gap : (k - t) * (k - t) / (2.0 * k);
        neck += filled / gap * glassShadowBox(local - float2(midU, midV), float2(0.5 * gap, 0.5 * straight), sigma);
    }
    return neck;
}

float glassShadowMask(float2 q, float sigma, out float seen) {
    float cover = 0.0;
    float neck = 0.0;
    float fused = 1000000.0;
    for (int i = 0; i < 8; ++i) {
        if (float(i) >= pieceCount) break;
        float4 ri = pieceRect[i];
        float d = glassSlab(q - ri.xy, ri.zw, pieceRadii[i], pieceSmooth[i]).x;
        float blend = pieceBlend[i];
        if (i == 0) {
            fused = d;
        } else {
            float k = max(blend, 0.0001);
            float h = clamp(0.5 + 0.5 * (d - fused) / k, 0.0, 1.0);
            fused = d + (fused - d) * h - k * h * (1.0 - h);
        }
        float own = glassShadowPiece(q - ri.xy, ri.zw, pieceRadii[i], pieceSmooth[i], sigma);
        float overlap = 0.0;
        for (int j = 0; j < 8; ++j) {
            if (j >= i) break;
            float4 rj = pieceRect[j];
            float2 lo = max(ri.xy - ri.zw, rj.xy - rj.zw);
            float2 hi = min(ri.xy + ri.zw, rj.xy + rj.zw);
            if (hi.x > lo.x && hi.y > lo.y) {
                overlap = max(overlap, glassShadowBox(q - (lo + hi) * 0.5, (hi - lo) * 0.5, sigma));
            }
            if (blend > 0.0001) {
                neck += glassShadowNeck(q, ri, pieceRadii[i], rj, pieceRadii[j], blend, sigma);
            }
        }
        cover += max(own - overlap, 0.0);
    }
    seen = fused;
    return clamp(cover + neck, 0.0, 1.0);
}
// <<< GlassShadowMask8

// >>> GlassTravelShadowFunctionBlock
half4 glassTravelShadow(float2 p, float d) {
    float contactAlpha = max(shadowAlphas.x, 0.0);
    float ambientAlpha = max(shadowAlphas.y, 0.0);
    if (contactAlpha + ambientAlpha <= 0.0) return half4(0.0);

    float contactSigma = glassShadowSigma(shadowRadii.x);
    float ambientSigma = glassShadowSigma(shadowRadii.y);
    float share = shadowRadii.y > 0.0 ? clamp(shadowRadii.x / shadowRadii.y, 0.0, 1.0) : 1.0;
    float slide = length(shadowOffset);
    float contactReach = contactAlpha > 0.0 ? 3.0 * contactSigma + share * slide : 0.0;
    float ambientReach = ambientAlpha > 0.0 ? 3.0 * ambientSigma + slide : 0.0;
    float reach = max(contactReach, ambientReach);
    if (d > reach) return half4(0.0);

    float amount = contactAlpha + ambientAlpha;
    if (d >= -reach) {
        // La sagoma vista dal punto spostato: la maschera del nucleo, che da' anche la distanza la'.
        float seen = d;
        float ambient = 0.0;
        if (ambientAlpha > 0.0) {
            ambient = glassShadowMask(p - shadowOffset, ambientSigma, seen);
        } else if (slide > 0.0) {
            float2 seenNormal;
            float2 seenCenter;
            seen = glassField(p - shadowOffset, seenNormal, seenCenter);
        }
        amount = contactAlpha * glassShadowFall(mix(d, seen, share), contactSigma) + ambientAlpha * ambient;
    }
    half strength = half(min(amount, 1.0)) * shadowColor.a;
    return half4(shadowColor.rgb * strength, strength);
}
// <<< GlassTravelShadowFunctionBlock

half4 main(float2 coord) {
    float2 p = glassFieldPoint(coord);
    float2 normal;
    float2 center;
    float d = glassField(p, normal, center);
    float coverage = clamp(0.5 - d / max(aa, 0.0001), 0.0, 1.0);
    half4 shade = glassTravelShadow(p, d);
    if (showMode > 1.5) return shade * half(1.0 - coverage);
    if (showMode > 0.5) return shade;
    half4 colour = half4(fillColor.rgb * fillColor.a, fillColor.a);
    return colour * half(coverage) + shade * half(1.0 - coverage);
}
